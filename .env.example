# Skopiuj do .env.local i uzupełnij. Opis zmiennych: docs/ARCHITEKTURA.md
DATABASE_URL=postgres://uzytkownik:haslo@host/baza?sslmode=require
# openssl rand -base64 32
AUTH_SECRET=
# hasło startowe konta admina "Bocian" (min. 8 znaków), przy pierwszym logowaniu system wymusi zmianę
BOCIAN_INITIAL_PASSWORD=

# opcjonalne
CRON_SECRET=
CATALOG_FEED_URL=
DONATE_URL=
PREMIUM_ENFORCED=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SUGGEST_DOMAINS=
# powiadomienia push: node scripts/vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
PUSH_CRON_HOURLY=
# push do aplikacji natywnej (Firebase): JSON klucza konta usługi (albo base64), patrz mobile/README.md
FIREBASE_SERVICE_ACCOUNT=
# e-mail (KON-1: weryfikacja adresu i odzyskiwanie hasła), bez obu funkcja jest ukryta.
# MAIL_FROM z neutralną nazwą i domeną (widać je w skrzynce), np. Notatnik <konto@twoja-domena.pl>
RESEND_API_KEY=
MAIL_FROM=
# adres aplikacji w linkach z maili (zalecane); bez niego tylko host z listy: domeny Vercel i APP_HOSTS
APP_URL=
APP_HOSTS=
# alerty o błędach serwera (PLA-2): webhook Discord/Slack (https) i/lub e-mail admina (wymaga wysyłki powyżej)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
ALERT_THRESHOLD=

# testy z bazą (npm run test:db), tylko lokalny PostgreSQL - baza jest czyszczona
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/zielnik_test
